    <node id="complaint_1160">
      <data key="d0">complaint</data>
      <data key="d1">ರಸ್ತೆ ಕತ್ತರಿಸಿದ ಜಾಗಕ್ಕೆ ಡಾಂಬರ್ ತುಂಬಿಸುವ ಬಗ್ಗೆ, ಮನೆ. ನ.210, 4ನೇ ಮುಖ್ಯ ರಸ್ತೆ 9ನೇ ಕ್ರಾಸ್, ಜಗಜ್ಯೋತಿ ಲೇಔಟ</data>
      <data key="d2">Ack by Contractor</data>
      <data key="d3">12.940091</data>
